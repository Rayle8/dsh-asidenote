{
  "name": "dsh-workspace-todos",
  "version": "1.4.13",
  "type": "module",
  "description": "Notes: a lightweight per-session sticky-note badge and floating panel for the DeepSeek Harness Web GUI.",
  "license": "MIT",
  "author": "Rayle8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayle8/dsh-workspace-todos.git"
  },
  "homepage": "https://github.com/Rayle8/dsh-workspace-todos#readme",
  "bugs": {
    "url": "https://github.com/Rayle8/dsh-workspace-todos/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "todo",
    "workspace",
    "productivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "preview.png",
    "preview-badge.png",
    "preview-history.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js && node --test tests/contract.test.mjs",
    "test": "node --test tests/contract.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
