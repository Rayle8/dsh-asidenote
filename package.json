{
  "name": "dsh-asidenote",
  "version": "2.0.1",
  "type": "module",
  "description": "AsideNote: a lightweight per-session notes button and right-side panel for the DeepSeek Harness Web GUI.",
  "license": "MIT",
  "author": "Rayle8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayle8/dsh-asidenote.git"
  },
  "homepage": "https://github.com/Rayle8/dsh-asidenote#readme",
  "bugs": {
    "url": "https://github.com/Rayle8/dsh-asidenote/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notes",
    "session-notes",
    "todo",
    "productivity"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "main": "index.js",
  "bin": {
    "dsh-asidenote": "scripts/install.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client/client.js",
    "scripts/install.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/assets",
    "docs/panel-ui-rules.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "node tools/release.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.23.4",
    "typescript": "~5.7.3",
    "vitest": "^4.1.12"
  }
}
